{
  "name": "marubako",
  "version": "3.1.0",
  "description": "Marubako desktop launcher widget",
  "author": "Marubako authors",
  "main": "out/main/index.js",
  "private": true,
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/KaidoAsuka/marubako.git"
  },
  "homepage": "https://github.com/KaidoAsuka/marubako#readme",
  "bugs": {
    "url": "https://github.com/KaidoAsuka/marubako/issues"
  },
  "keywords": [
    "launcher",
    "windows",
    "electron",
    "floating-bubble",
    "productivity",
    "desktop",
    "shortcuts"
  ],
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "predev": "node node_modules/electron/install.js",
    "dev": "electron-vite dev",
    "typecheck": "tsc -p tsconfig.main.json --noEmit && tsc -p tsconfig.preload.json --noEmit && tsc -p tsconfig.renderer.json --noEmit",
    "build": "npm run typecheck && electron-vite build",
    "prepreview": "node node_modules/electron/install.js",
    "preview": "electron-vite preview",
    "lint": "eslint .",
    "format": "prettier --write .",
    "icons": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/generate-icons.ps1",
    "predist": "node -e \"const fs=require('node:fs');const path=require('node:path');const pkg=require('./package.json');fs.rmSync(path.join('release', pkg.version), { recursive: true, force: true })\"",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "test:e2e": "npm run build && playwright test",
    "dist": "npm run build && electron-builder --config electron-builder.config.cjs --win nsis --publish never && node scripts/make-portable.cjs",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.{ts,tsx,js,mjs,cjs}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,css,md,html,yml,yaml}": [
      "prettier --write"
    ]
  },
  "dependencies": {
    "electron-log": "^5.3.4",
    "electron-updater": "^6.8.9"
  },
  "devDependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@eslint/js": "^9.38.0",
    "@phosphor-icons/core": "^2.1.1",
    "@phosphor-icons/react": "^2.1.10",
    "@playwright/test": "^1.56.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.0",
    "@types/node": "^24.10.1",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@typescript-eslint/eslint-plugin": "^8.46.1",
    "@typescript-eslint/parser": "^8.46.1",
    "@vitejs/plugin-react": "^5.1.0",
    "@vitest/coverage-v8": "^3.2.4",
    "electron": "^44.5.1",
    "electron-builder": "^26.17.0",
    "electron-vite": "^5.0.0",
    "eslint": "^9.38.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "globals": "^16.4.0",
    "husky": "^9.1.7",
    "jsdom": "^27.0.1",
    "lint-staged": "^16.4.0",
    "prettier": "^3.6.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "typescript": "^5.9.3",
    "vite": "^7.1.11",
    "vitest": "^3.2.4",
    "zustand": "^5.0.8"
  }
}
